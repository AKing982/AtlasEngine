use crate::vector::Vector;

#[derive(Debug, Clone)]
struct Matrix {
    rows: usize,
    cols: usize,
    matrix: Vec<usize>,
}

impl Matrix {

    pub(crate) fn new(cols: usize, rows: usize, fill: i32) -> Self {
        Self {
            matrix: vec![fill; rows * cols],
            rows,
            cols,
        }
    }

    pub(crate) fn get(&self, row: usize, col: usize) -> usize {
        self.matrix[row * self.cols + col]
    }

    pub(crate) fn rows(&self) -> usize{
        self.matrix.len()
    }

    pub(crate) fn cols(&self) -> usize {
        self.matrix.first().map_or(0, |r| r.len())
    }

    pub(crate) fn size(&self) -> (usize, usize) {
        (self.row, self.col)
    }
    
    pub(crate) fn subtract(&self, other: &Self) -> Self {
        if self.size() != other.size(){
            panic!("Cannot perform matrix subtraction on matrices of different sizes");
        }
        let subtracted_data: Vec<usize> = self.matrix
            .iter()
            .zip(other.matrix.iter())
            .map(|(a, b)| a - b)
            .collect();
        Self {
            matrix: subtracted_data,
            rows: self.rows,
            cols: self.cols,
        }
    }
 
    pub(crate) fn add(&self, other: &Self) -> Self {
        if self.size() != other.size(){
            panic!("Cannot perform matrix addition on matrices of different sizes");
        }
        let a_rows = self.matrix.rows;
        let b_rows = other.matrix.rows;

        // sum each row component-wise
        let summed_rows: Vec<usize> = self.matrix
            .iter()
            .zip(other.matrix.iter())
            .map(|(a,b)| a + b)
            .collect();

        // reconstruct a new matrix with the new added components for each entry
        Self {
            matrix: summed_rows,
            rows: self.rows,
            cols: self.cols,
        }
    }

    pub(crate) fn diagonal(&self, isLeft: bool) -> usize {
        if self.matrix.row != self.matrix.col || self.matrix.row < 2{
            panic!("Cannot perform diagonal operation on square matrix of dimension less than 2");
        }
        let rows = self.matrix.len();
        let cols = self.matrix[0].len();
        let mut product: usize = 1;
        if isLeft {
            for i in 0..rows {
                product *= self.matrix[i][i]
            }
        }else{
            for i in 0..rows {
                product *= self.matrix[i][cols - 1 - i];
            }
        }
        product
    }

