    pub(crate) fn eye(dim: usize) -> Self {
        if dim < 0 || dim == 0{
            panic!("The dimension must be greater than zero");
        }
        let rows = dim;
        let cols = dim;
        let mut identity = Vec::with_capacity(dim * dim);
        for i in rows {
            for j in cols {
                if i == j {
                    identity.push(1);
                }else{
                    identity.push(0);
                }
            }
        }
        Self {
            col: cols,
            row: rows,
            matrix: identity
        }
    }
    
    pub(crate) fn print_size(&self) {
        println!("({}, {})", self.row, self.col);
    }

    pub(crate) fn print(&self) {
        print!("[");
        for i in 0..self.row {
            print!("[");
            for j in 0..self.col {
                print!("{}", self.matrix[i * self.col + j]);
                if j < self.col - 1 {
                    print!(", ");
                }
            }
            print!("]");
            if i < self.row - 1 {
                println!(",");
            }
        }
        println!("]");
    }
