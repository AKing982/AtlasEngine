
use crate::ast_expr::AstExpr;
use crate::token::Token;
use crate::token_type::TokenType;
use crate::parse_error::ParseError;
use crate::ast_stmt::AstStmt;
use crate::complex::Complex;
use crate::literal::Literal;

pub struct Parser {
    tokens: Vec<Token>,
    current: usize,
}

impl Parser {
    pub(crate) fn new(tokens: Vec<Token>) -> Self {
        Self {
            tokens,
            current: 0,
        }
    }

    fn statement(&mut self) -> Result<AstStmt, ParseError>{
        let expression = self.expression()?;
        if !self.match_token(&[TokenType::SemiColon]) && !self.is_at_end() {
            return Err(self.error(
                self.peek(),
                "Expect ';' after expression",
            ));
        }
        Ok(AstStmt::Expression{expression})
    }

    fn declaration(&mut self) -> Result<AstStmt, ParseError>{
        if self.match_token(&[TokenType::Var]){
            return self.var_declaration();
        }
        self.statement()
    }

    fn var_declaration(&mut self) -> Result<AstStmt, ParseError> {
        let name = self.consume(TokenType::Identifier,
        "Expect variable name.")?;
        let initializer = if self.match_token(&[TokenType::Equal]){
            Some(self.expression()?)
        }else{
            None
        };
        self.consume(TokenType::SemiColon,
        "Expect ';' after variable declaration")?;
        Ok(AstStmt::Var {
            name,
            initializer
        })
    }

    fn power(&mut self) -> Result<AstExpr, ParseError>{
        let mut expression = self.call()?;
        if self.match_token(&[TokenType::Caret]){
            let operator = self.previous().clone();
            let right = self.unary()?;
            expression = AstExpr::Binary {
                left: Box::new(expression),
                operator,
                right: Box::new(right),
            };
        }
        Ok(expression)
    }

    fn solve(&mut self) -> Result<AstExpr, ParseError> {
        let name = self.previous().clone()?;
        self.consume(TokenType::LeftParen,
        "Expect '(' after solve")?;
        let left = self.expression()?;
        let operator = self.consume(TokenType::Equal,
        "Expect '=' in equation")?.clone();
        let right = self.expression()?;
        let equation = AstExpr::Equation {
            left: Box::new(left),
            operator,
            right: Box::new(right),
        }
        self.consume(TokenType::Comma,
        "Expect ',' after equation")?;
        let variable = self.expression()?;
        self.consume(TokenType::RightParen,
        "Expect ')' after equation")?;
        Ok(AstExpr::Call {
            callee: Box::new(AstExpr::Function {name}),
            arguments: vec![equation, 
            AstExpr::Variable {name, variable},]
        })
    }

    fn expression(&mut self) -> Result<AstExpr, ParseError> {
        self.assignment()
    }

    fn match_token(&mut self, types: &[TokenType]) -> bool {
        for token_type in types {
            if self.check_token(token_type) {
                self.advance();
                return true;
            }
        }
        false
    }

    fn error(&self, _token: &Token, message: &str) -> ParseError {
        ParseError::new(message)
    }

    fn check_token(&self, token_type: &TokenType) -> bool {
        !self.is_at_end() && &self.peek().token_type == token_type
    }

    fn advance(&mut self) -> &Token {
        if !self.is_at_end() {
            self.current += 1;
        }
        self.previous()
    }

    fn previous(&self) -> &Token {
        &self.tokens[self.current - 1]
    }

    fn peek(&self) -> &Token {
        &self.tokens[self.current]
    }

    fn is_at_end(&self) -> bool {
        self.peek().token_type == TokenType::Eof
    }

    fn primary(&mut self) -> Result<AstExpr, ParseError> {
        if self.match_token(&[TokenType::False]) {
            return Ok(AstExpr::Literal {
                value: Literal::Boolean(false),
            });
        }

        if self.match_token(&[TokenType::True]) {
            return Ok(AstExpr::Literal {
                value: Literal::Boolean(true),
            });
        }

        if self.match_token(&[TokenType::Nil]) {
            return Ok(AstExpr::Literal {
                value: Literal::Nil(),
            });
        }

        if self.match_token(&[TokenType::LeftParen]) {
            let expr = self.expression()?;

            self.consume(
                TokenType::RightParen,
                "Expect ')' after expression.",
            )?;

            return Ok(AstExpr::Grouping {
                expression: Box::new(expr),
            });
        }

        if self.match_token(&[TokenType::Number]){
            return Ok(AstExpr::Literal {
                value: self.previous()
                    .literal
                    .clone()
                    .expect("Number token should contain a literal"),
            });
        }

        if self.match_token(&[TokenType::Identifier]){
            return Ok(AstExpr::Variable {
                name: self.previous().clone(),
            });
        }

        if self.match_token(&[TokenType::Exp,
        TokenType::Sin, TokenType::Cos, TokenType::Tan, TokenType::Ln, TokenType::Log,
        TokenType::Sqrt, TokenType::Complex, TokenType::Conjugate, TokenType::Limit, TokenType::Derivative]){
            return Ok(AstExpr::Function {
                name: self.previous().clone(),
            })
        }

        if self.match_token(&[TokenType::I]){
            return Ok(AstExpr::Literal {
                value: Literal::Complex(Complex::i()),
            });
        }
        if self.match_token(&[TokenType::E]){
            return Ok(AstExpr::Literal {
                value: Literal::Number(std::f64::consts::E)
            })
        }
        if self.match_token(&[TokenType::Pi]){
            return Ok(AstExpr::Literal {
                value: Literal::Number(std::f64::consts::PI)
            })
        }
        if self.match_token(&[TokenType::Solve]){
            return self.solve();
        }
        Err(self.error(self.peek(), "Expect expression."))
    }

    fn assignment(&mut self) -> Result<AstExpr, ParseError>{
        let mut expr = self.equality()?;
        if self.match_token(&[TokenType::Equal]){
            let value = self.assignment()?;
            if let AstExpr::Variable {name} = expr {
                return Ok(AstExpr::Assign {
                    name,
                    value: Box::new(value),
                });
            }
            return Err(self.error(
                self.previous(),
                "Invalid assignment target.",
            ));
        }
        Ok(expr)
    }

    fn call(&mut self) -> Result<AstExpr, ParseError>{
        let mut expr = self.primary()?;
        if self.match_token(&[TokenType::LeftParen]){
           let mut arguments = Vec::new();
           if !self.check(&TokenType::RightParen){
               loop {
                   arguments.push(self.expression()?);
                   if !self.match_token(&[TokenType::Comma]){
                       break;
                   }

               }
           }
            self.consume(TokenType::RightParen,
            "Expect ')' after expression")?;
            expr = AstExpr::Call {
                callee: Box::new(expr),
                arguments,
            };
        }
        Ok(expr)
    }

    fn check(&self, token_type: &TokenType) -> bool {
        if self.is_at_end() {
            return false;
        }
        self.peek().token_type == *token_type
    }

    pub(crate) fn parse(&mut self) -> Result<Vec<AstStmt>, ParseError> {
        let mut statements = Vec::new();
        while !self.is_at_end(){
            statements.push(self.declaration()?);
        }
        Ok(statements)
    }

    fn consume(
        &mut self,
        token_type: TokenType,
        message: &str,
    ) -> Result<Token, ParseError> {
        if self.check_token(&token_type) {
            return Ok(self.advance().clone());
        }

        Err(self.error(self.peek(), message))
    }

    fn unary(&mut self) -> Result<AstExpr, ParseError> {
        if self.match_token(&[
            TokenType::Bang,
            TokenType::Minus,
        ]) {
            let operator = self.previous().clone();
            let right = self.unary()?;
            return Ok(AstExpr::Unary {
                operator,
                right: Box::new(right),
            });
        }

        self.power()
    }

    fn term(&mut self) -> Result<AstExpr, ParseError> {
        let mut expr = self.factor()?;
        while self.match_token(&[
            TokenType::Minus,
            TokenType::Plus,
        ]) {
            let operator = self.previous().clone();
            let right = self.factor()?;
            expr = AstExpr::Binary {
                left: Box::new(expr),
                operator,
                right: Box::new(right),
            };
        }
        Ok(expr)
    }

    fn factor(&mut self) -> Result<AstExpr, ParseError> {
        let mut expr = self.unary()?;
        while self.match_token(&[
            TokenType::Slash,
            TokenType::Star,
        ]) {
            let operator = self.previous().clone();
            let right = self.unary()?;
            expr = AstExpr::Binary {
                left: Box::new(expr),
                operator,
                right: Box::new(right),
            };
        }
        Ok(expr)
    }

    fn comparison(&mut self) -> Result<AstExpr, ParseError> {
        let mut expr = self.term()?;
        while self.match_token(&[
            TokenType::Greater,
            TokenType::GreaterEqual,
            TokenType::Less,
            TokenType::LessEqual,
        ]) {
            let operator = self.previous().clone();
            let right = self.term()?;

            expr = AstExpr::Binary {
                left: Box::new(expr),
                operator,
                right: Box::new(right),
            };
        }

        Ok(expr)
    }

    fn equality(&mut self) -> Result<AstExpr, ParseError> {
        let mut expr = self.comparison()?;
        while self.match_token(&[
            TokenType::BangEqual,
            TokenType::EqualEqual,
        ]) {
            let operator = self.previous().clone();
            let right = self.comparison()?;

            expr = AstExpr::Binary {
                left: Box::new(expr),
                operator,
                right: Box::new(right),
            };
        }

        Ok(expr)
    }

}
